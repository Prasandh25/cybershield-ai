# ============================================
# Python
# ============================================
# Virtual environment — machine-specific, rebuildable from requirements.txt
.venv/
env/
venv/

# Bytecode cache — regenerated automatically, never source
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging artifacts
build/
dist/
*.egg-info/

# pytest cache
.pytest_cache/

# ============================================
# Node / React (dashboard/)
# ============================================
# Installed packages — reinstallable from package.json, often 100k+ files
dashboard/node_modules/

# Production build output — regenerated by `npm run build`
dashboard/dist/

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# PyCharm / IDE
# ============================================
# Project-specific IDE settings — machine-specific, causes merge conflicts if shared
.idea/

# ============================================
# Datasets and model artifacts
# ============================================
# Raw and processed data — multiple GB, not your IP to redistribute, and not source code
data/raw/
data/interim/
data/processed/

# Trained model binaries — large, regenerable by re-running train.py against the data
models/artifacts/*.pkl
models/artifacts/*.joblib
models/artifacts/*.cbm

# ============================================
# Runtime-generated output
# ============================================
# Generated PDF reports — output, not source
reports/generated/

# SQLite database files — runtime data
*.db
*.sqlite3

# Logs
*.log

# ============================================
# Secrets
# ============================================
# Environment variables and credentials — never commit these
.env
.env.local

# ============================================
# OS cruft
# ============================================
.DS_Store
Thumbs.db